  (paper "A3")
  (title_block
    (title "Autek QF-1 — Main Filter Board")
    (date "2026-11-19")
    (rev "1.0")
    (company "Redrawn from Autek Research QF-1 manual")
    (comment 1 "U1-U3 TL072 replace uA747 (A/B halves keep the original U1A..U3B roles); U4 TL071 replaces uA741")
    (comment 2 "J1-J4 keep the original board pin numbers 1-21 (J2 pin n = board pin n+7). Dashed box = chassis boundary")
    (comment 3 "R3,R5,R10,R11 3.3K-6.8K matched to C2-C5 (1%); R4,R9 select to match selectivity pot")
    (comment 4 "C9, C10 values not given on original (optional, DNP); C7 not used in QF-1 (DNP)")
  )
