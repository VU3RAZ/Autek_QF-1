  (text "Mounting holes"
    (at 324 173 0)
    (effects
      (font
        (size 2 2)
        bold
      )
      (justify left bottom)
    )
    (uuid "184db8d6-1082-4f3d-b3a4-2b903baee62f")
  )
  (text "FRONT-PANEL WIRING (as original):\n  5+6 tied -> front SELECTIVITY wiper; 8 -> top of front SELECTIVITY and front FREQUENCY wiper\n  9 -> top of front FREQUENCY;  13+16 tied -> rear SELECTIVITY wiper\n  18 -> top of rear SELECTIVITY and rear FREQUENCY wiper;  15 -> top of rear FREQUENCY\n  Pots: dual 500K (front/rear), bottom terminals open\n  Switch pole 1: common 12, PK 5, NTCH 10, LP 11\n  Switch pole 2: common 3,  PK 19, NTCH 17, LP 14\n  21 = QF-1 output to amp board IN;  20 = ground;  1 = B+ from amp board\nSUBSTITUTIONS / ADDITIONS: TL072 for uA747, TL071 for uA741; C13-C15 supply decoupling added"
    (at 22 250 0)
    (effects
      (font
        (size 1.6 1.6)
      )
      (justify left bottom)
    )
    (uuid "8d678f42-7dfc-49af-99b5-c37a5e65881b")
  )
